# ============================================================================
# Cayworks WebBuilder Workspace — Environment Variables
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values.
# Only variables prefixed with VITE_ are exposed to the frontend bundle.
# NEVER put secrets (master keys, service keys) in a VITE_ variable.
# ============================================================================

# --- Public app config (safe to expose) -------------------------------------
VITE_APP_NAME="Cayworks WebBuilder Workspace"
VITE_COMPANY_NAME="NB Solutions / Cayworks"
VITE_PUBLIC_SERVICE_URL="https://websites.cayworks.com/"
VITE_DEFAULT_CONTACT_EMAIL="info@cayworks.com"
VITE_DEFAULT_PHONE="345 324 9000"
VITE_BASE_PACKAGE_PRICE="250"
VITE_DOMAIN_ADDON_PRICE="50"
VITE_ADS_ENGINE_URL="https://ads.cayworks.com/"

# --- Analytics placeholders (safe to expose) --------------------------------
VITE_GOOGLE_TRACKING_ID=""
VITE_META_PIXEL_ID=""

# --- The SuperAdmin email may be public; it only identifies the account ------
VITE_SUPER_ADMIN_EMAIL="info@cayworks.com"

# --- Supabase (production data layer) ---------------------------------------
# The anon key is designed to be public IF Row Level Security is enabled.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# ============================================================================
# SERVER-ONLY SECRETS — do NOT prefix with VITE_, do NOT read on the frontend.
# These belong in Netlify environment variables / serverless functions only.
# ============================================================================
SUPER_ADMIN_EMAIL="info@cayworks.com"
SUPERADMIN_MASTER_KEY="change-me-to-a-long-random-string"
SUPABASE_SERVICE_ROLE_KEY=""
